<%- include('partials/header') %>
<div class="flex justify-center items-center py-10">
  <div class="w-full max-w-md bg-white rounded-xl shadow-md border border-slate-200 p-8">
    <div class="text-center mb-6">
      <div class="w-12 h-12 bg-indigo-100 text-indigo-700 rounded-full flex items-center justify-center mx-auto mb-3">
        <i class="fa-solid fa-lock text-xl"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-800" data-i18n="nav_login">Portal Login</h2>
      <p class="text-sm text-slate-500 mt-1">Access your bidder account or official government console</p>
    </div>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Official / Business Email</label>
        <input type="email" name="email" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="name@domain.com">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
        <input type="password" name="password" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="••••••••">
      </div>

      <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-sm transition">
        Sign In
      </button>
    </form>

    <div class="mt-6 text-center text-sm text-slate-600">
      <span>New to the system? </span>
      <a href="/register" class="text-indigo-600 font-semibold hover:underline">Apply for an Account</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
