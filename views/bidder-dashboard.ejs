<%- include('partials/header') %>
<div class="space-y-8">
  <!-- Bidder Welcome Header -->
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Bidder Portal: <%= user.companyDetails.companyName || user.name %></h1>
      <p class="text-sm text-slate-500">Registration Number: <span class="font-mono text-indigo-600"><%= user.companyDetails.registrationNumber || 'Pending Entry' %></span></p>
    </div>
    <a href="/settings" class="px-4 py-2 border rounded-lg text-sm text-slate-700 hover:bg-slate-50">
      <i class="fa-solid fa-pen-to-square mr-1"></i> Edit Company Portfolio
    </a>
  </div>

  <!-- Won Tenders Section (with File Download) -->
  <div>
    <h2 class="text-xl font-bold text-slate-800 mb-3 flex items-center">
      <i class="fa-solid fa-award mr-2 text-amber-500"></i> My Awarded Contracts (<%= wonTenders.length %>)
    </h2>
    <% if (wonTenders.length === 0) { %>
      <div class="bg-white rounded-xl p-6 border border-slate-200 text-slate-500 text-sm">
        No tenders currently awarded to your company. Submit competitive bids below to win government contracts.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% wonTenders.forEach(t => { %>
          <div class="bg-emerald-50/60 border border-emerald-200 rounded-xl p-5 shadow-sm">
            <div class="flex justify-between items-start">
              <span class="text-xs font-mono font-bold text-emerald-800"><%= t.tenderId %></span>
              <span class="text-xs bg-emerald-600 text-white font-semibold px-2 py-0.5 rounded">AWARDED</span>
            </div>
            <h3 class="text-lg font-bold text-slate-800 mt-2"><%= t.title %></h3>
            <p class="text-xs text-slate-600 mt-1">Location: <%= t.location.taluk %>, <%= t.location.district %>, <%= t.location.state %></p>
            <p class="text-sm font-bold text-emerald-700 mt-2">Budget: INR <%= t.budget.toLocaleString('en-IN') %></p>

            <div class="mt-4 pt-3 border-t border-emerald-200 flex justify-end">
              <a href="/tenders/<%= t._id %>/contract-download" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow-sm transition flex items-center" data-i18n="download_doc">
                <i class="fa-solid fa-file-pdf mr-2"></i> Download Contract File
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Search & Filter Open Tenders -->
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <h2 class="text-xl font-bold text-slate-800 mb-4">Browse Available Tenders</h2>
    <form method="GET" action="/bidder/dashboard" class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-6">
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Keyword or Tender ID" class="px-3 py-2 border rounded-lg text-sm">
      <input type="text" name="state" value="<%= filters.state || '' %>" placeholder="Filter by State" class="px-3 py-2 border rounded-lg text-sm">
      <input type="text" name="category" value="<%= filters.category || '' %>" placeholder="Category (e.g. Roads)" class="px-3 py-2 border rounded-lg text-sm">
      <button type="submit" class="py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg transition">
        Filter Tenders
      </button>
    </form>

    <!-- Tender List Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% availableTenders.forEach(tender => { %>
        <div class="border rounded-xl p-5 flex flex-col justify-between hover:shadow-md transition">
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-mono font-bold text-indigo-700"><%= tender.tenderId %></span>
              <span class="text-xs bg-indigo-100 text-indigo-800 font-semibold px-2 py-0.5 rounded"><%= tender.category %></span>
            </div>
            <h3 class="text-md font-bold text-slate-900 mb-1"><%= tender.title %></h3>
            <p class="text-xs text-slate-500 mb-3 line-clamp-3"><%= tender.description %></p>
            <div class="text-xs space-y-1 mb-4 text-slate-600">
              <div><strong>Budget:</strong> INR <%= tender.budget.toLocaleString('en-IN') %></div>
              <div><strong>Location:</strong> <%= tender.location.taluk %>, <%= tender.location.state %></div>
              <div><strong>Active Bids Submitted:</strong> <%= tender.bids.length %></div>
            </div>
          </div>

          <form action="/bidder/tenders/<%= tender._id %>/bid" method="POST" class="border-t pt-3 space-y-2">
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">Your Bid Amount (INR)</label>
              <input type="number" name="bidAmount" required placeholder="e.g. <%= tender.budget %>" class="w-full px-3 py-1.5 text-sm border rounded-lg">
            </div>
            <div>
              <input type="text" name="proposalNote" placeholder="Technical delivery timeframe / notes" class="w-full px-3 py-1.5 text-xs border rounded-lg">
            </div>
            <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-lg transition">
              Submit Quotation / Bid
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
