<%- include('partials/header') %>
<div class="space-y-8">
  <div class="border-b pb-4">
    <h1 class="text-3xl font-extrabold text-slate-900">Government Official Control Center</h1>
    <p class="text-slate-500 text-sm">Administrative oversight for user approvals, tender management, and contract awards.</p>
  </div>

  <!-- User Account Approvals Section -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center">
      <i class="fa-solid fa-user-clock mr-2 text-amber-500"></i> Pending User Registrations Awaiting Verification (<%= pendingUsers.length %>)
    </h2>

    <% if (pendingUsers.length === 0) { %>
      <p class="text-sm text-slate-500">No new users waiting for approval.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 border-b text-slate-600 uppercase text-xs">
              <th class="p-3">Applicant Name</th>
              <th class="p-3">Email</th>
              <th class="p-3">Role</th>
              <th class="p-3">Company & Registration</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pendingUsers.forEach(u => { %>
              <tr class="border-b hover:bg-slate-50">
                <td class="p-3 font-semibold text-slate-900"><%= u.name %></td>
                <td class="p-3 text-slate-600"><%= u.email %></td>
                <td class="p-3"><span class="px-2 py-0.5 rounded text-xs uppercase font-bold <%= u.role === 'official' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800' %>"><%= u.role %></span></td>
                <td class="p-3 text-slate-600">
                  <%= u.companyDetails.companyName || 'N/A' %> 
                  <span class="block text-xs text-slate-400"><%= u.companyDetails.registrationNumber %></span>
                </td>
                <td class="p-3 text-right space-x-2">
                  <form action="/govt/approve-user/<%= u._id %>" method="POST" class="inline">
                    <button type="submit" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-semibold">
                      Approve & Activate
                    </button>
                  </form>
                  <form action="/govt/reject-user/<%= u._id %>" method="POST" class="inline">
                    <button type="submit" class="px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded text-xs font-semibold">
                      Reject
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Create New Tender Modal/Form -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center">
      <i class="fa-solid fa-plus-circle mr-2 text-indigo-600"></i> Publish New Tender
    </h2>
    <form action="/govt/tenders/add" method="POST" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Tender Title</label>
          <input type="text" name="title" required placeholder="Construction of High School" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Category</label>
          <input type="text" name="category" required placeholder="Civil / Roads / IT" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Type</label>
          <select name="type" class="w-full px-3 py-2 border rounded-lg text-sm bg-white">
            <option value="Open">Open Tender</option>
            <option value="Limited">Limited Tender</option>
            <option value="Global">Global Tender</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Budget (INR)</label>
          <input type="number" name="budget" required placeholder="5000000" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">State</label>
          <input type="text" name="state" required placeholder="Karnataka" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">District</label>
          <input type="text" name="district" required placeholder="Bengaluru Urban" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Taluk</label>
          <input type="text" name="taluk" required placeholder="Yelahanka" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 mb-1">Village</label>
          <input type="text" name="village" placeholder="Singanayakanahalli" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-700 mb-1">Description & Scope of Work</label>
        <textarea name="description" rows="2" required placeholder="Enter full specifications and scope of the tender..." class="w-full px-3 py-2 border rounded-lg text-sm"></textarea>
      </div>

      <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-lg transition shadow-sm">
        Publish Tender Notice
      </button>
    </form>
  </div>

  <!-- Manage & Assign Tenders -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <h2 class="text-xl font-bold text-slate-800 mb-4">Existing Tenders & Bids Received</h2>
    <div class="space-y-4">
      <% tenders.forEach(tender => { %>
        <div class="border rounded-xl p-5 hover:border-slate-300 transition">
          <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2 mb-2">
            <div>
              <span class="text-xs font-mono font-bold text-indigo-700"><%= tender.tenderId %></span>
              <h3 class="text-lg font-bold text-slate-900 inline ml-2"><%= tender.title %></h3>
            </div>
            <div class="space-x-2">
              <span class="text-xs uppercase px-2 py-0.5 rounded font-bold <%= tender.status === 'assigned' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                <%= tender.status %>
              </span>
              <form action="/govt/tenders/<%= tender._id %>/delete" method="POST" class="inline">
                <button type="submit" class="text-xs text-rose-600 hover:underline">Remove</button>
              </form>
            </div>
          </div>

          <p class="text-sm text-slate-600 mb-3"><%= tender.description %></p>
          <p class="text-xs text-slate-500 mb-4">Location: <%= tender.location.taluk %>, <%= tender.location.district %> | Budget: INR <%= tender.budget.toLocaleString('en-IN') %></p>

          <!-- Bids Assignment Section -->
          <div class="bg-slate-50 p-4 rounded-lg border">
            <h4 class="text-xs uppercase font-bold text-slate-600 mb-2">Incoming Quotations / Bids (<%= tender.bids.length %>)</h4>
            <% if (tender.bids.length === 0) { %>
              <p class="text-xs text-slate-400">No bids submitted yet by registered bidders.</p>
            <% } else { %>
              <div class="space-y-2">
                <% tender.bids.forEach(bid => { %>
                  <div class="flex justify-between items-center text-xs bg-white p-2.5 rounded border">
                    <div>
                      <strong class="text-slate-800"><%= bid.companyName %></strong> (<%= bid.bidderName %>)
                      <span class="text-slate-500 block">Bid: INR <%= bid.bidAmount.toLocaleString('en-IN') %> • <%= bid.proposalNote %></span>
                    </div>
                    <% if (tender.status !== 'assigned') { %>
                      <form action="/govt/tenders/<%= tender._id %>/assign" method="POST">
                        <input type="hidden" name="bidderId" value="<%= bid.bidderId %>">
                        <button type="submit" class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-indigo-950 font-bold rounded">
                          Award Contract
                        </button>
                      </form>
                    <% } else if (tender.assignedBidder && tender.assignedBidder._id.toString() === bid.bidderId.toString()) { %>
                      <span class="text-emerald-700 font-bold"><i class="fa-solid fa-check"></i> Contract Awarded</span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
